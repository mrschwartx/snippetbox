{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "snippetbox",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "pull-request-title-pattern": "chore(ci): release${component} ${version}",
      "extra-files": [
        {
          "type": "json",
          "path": "snippetbox/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "snippetbox/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "snippetbox/package-lock.json",
          "jsonpath": "$.packages[''].version"
        }
      ]
    }
  }
}
