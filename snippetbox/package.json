{
  "name": "snippetbox",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ui": "vitest run --project ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "node -e \"require('node:fs').rmSync('.e2e-data',{recursive:true,force:true})\"",
    "test:e2e": "playwright test",
    "test:e2e:ci": "npm run build && playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:e2e:ci"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "^5",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsdom": "^27",
    "typescript": "^5",
    "vitest": "^5"
  }
}
